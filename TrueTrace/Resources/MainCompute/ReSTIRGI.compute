struct ReservoirStruct
{
    uint2 MergedCoord;
    
    float3 Color;
    float Wsum;
    float M;
    float W;

    float UnbiasedCannonWeight;
    float3 OriginNormal;
    float3 WorldPos;
};


RWStructuredBuffer<ReservoirStruct> ReservoirA;
StructuredBuffer<ReservoirStruct> ReservoirB;

// ------------------------ RESERVOIRStruct PACKING FUNCTIONS-----------------------




// Empty reservoirStruct initialization
inline void ReservoirInitialize(uint2 Coord, out ReservoirStruct Reservoir)
{
    Reservoir.MergedCoord = Coord;
    Reservoir.Color = 0;
    Reservoir.Wsum = 0;
    Reservoir.M = 0;
    Reservoir.W = 0;
    Reservoir.OriginNormal = 0;
    Reservoir.WorldPos = 0;
    Reservoir.UnbiasedCannonWeight = 0;
}


inline uint UnpackCase(uint4 RayDataPacked)
{
    return RayDataPacked.w >> 24;
}

float jacobian(
    float3 new_world_position,
    float3 original_world_position,
    float3 sample_point_world_position,
    float3 sample_point_world_normal) {
    float3 r = new_world_position - sample_point_world_position;
    float3 q = original_world_position - sample_point_world_position;
    float rl = length(r);
    float ql = length(q);
    float phi_r = saturate(dot(r / rl, sample_point_world_normal));
    float phi_q = saturate(dot(q / ql, sample_point_world_normal));
    float jacobian = (phi_r * ql * ql) / (phi_q * rl * rl);
    return jacobian;//select(jacobian, 0.0, isinf(jacobian) || isnan(jacobian));
}

float balance_heuristic(float x, float y) {
    float sum = x + y;
    if(sum == 0.0) {
        return 0.0;
    }
    return x / sum;
}



ReservoirStruct merge_reservoirs(
    ReservoirStruct canonical_reservoir,
    float3 canonical_world_position,
    float3 canonical_world_normal,
    float3 canonical_diffuse_brdf,
    ReservoirStruct other_reservoir,
    float3 other_world_position,
    float3 other_world_normal,
    float3 other_diffuse_brdf,
    float rand,
    int2 id,
    inout bool Replaced) {
    // Radiances for resampling
    float3 canonical_sample_radiance = canonical_reservoir.Color * saturate(dot(normalize(canonical_reservoir.WorldPos - canonical_world_position), canonical_world_normal));
    float3 other_sample_radiance = other_reservoir.Color * saturate(dot(normalize(other_reservoir.WorldPos - canonical_world_position), canonical_world_normal));

    // Target functions for resampling and MIS
    float canonical_target_function_canonical_sample = luminance(canonical_sample_radiance * canonical_diffuse_brdf);
    float canonical_target_function_other_sample = luminance(other_sample_radiance * canonical_diffuse_brdf);

    // Extra target functions for MIS
    float other_target_function_canonical_sample = luminance(
        canonical_reservoir.Color * saturate(dot(normalize(canonical_reservoir.WorldPos - other_world_position), other_world_normal)) * other_diffuse_brdf
    );
    float other_target_function_other_sample = luminance(
        other_reservoir.Color * saturate(dot(normalize(other_reservoir.WorldPos - other_world_position), other_world_normal)) * other_diffuse_brdf
    );

    // Jacobians for resampling and MIS
    float canonical_target_function_other_sample_jacobian = jacobian(
        canonical_world_position,
        other_world_position,
        other_reservoir.WorldPos,
        other_reservoir.OriginNormal
    );
    float other_target_function_canonical_sample_jacobian = jacobian(
        other_world_position,
        canonical_world_position,
        canonical_reservoir.WorldPos,
        canonical_reservoir.OriginNormal
    );

    // Don't merge samples with huge jacobians, as it explodes the variance
    if(canonical_target_function_other_sample_jacobian > 1.2) {
        canonical_reservoir.Color = canonical_sample_radiance;
        Replaced = false;
        return canonical_reservoir;
    }

    // Resampling weight for canonical sample
    float canonical_sample_mis_weight = balance_heuristic(
        canonical_reservoir.W * canonical_target_function_canonical_sample,
        other_reservoir.W * other_target_function_canonical_sample * other_target_function_canonical_sample_jacobian
    );
    float canonical_sample_resampling_weight = canonical_sample_mis_weight * canonical_target_function_canonical_sample * canonical_reservoir.UnbiasedCannonWeight;

    // Resampling weight for other sample
    float other_sample_mis_weight = balance_heuristic(
        other_reservoir.W * other_target_function_other_sample,
        canonical_reservoir.W * canonical_target_function_other_sample * canonical_target_function_other_sample_jacobian
    );
    float other_sample_resampling_weight = other_sample_mis_weight * canonical_target_function_other_sample * other_reservoir.UnbiasedCannonWeight * canonical_target_function_other_sample_jacobian;

    // Perform resampling
    ReservoirStruct combined_reservoir;
    combined_reservoir.M = canonical_reservoir.M + other_reservoir.M;
    combined_reservoir.MergedCoord = 0;
    combined_reservoir.W = canonical_reservoir.W + other_reservoir.W;
    combined_reservoir.Wsum = max(canonical_sample_resampling_weight + other_sample_resampling_weight,0);

    _DebugTex[id.xy] = other_sample_resampling_weight;
    if (rand < other_sample_resampling_weight / combined_reservoir.Wsum) {
        combined_reservoir.WorldPos = other_reservoir.WorldPos;
        combined_reservoir.OriginNormal = other_reservoir.OriginNormal;
        combined_reservoir.Color = other_reservoir.Color;

        float inverse_target_function = (canonical_target_function_other_sample > 0.0) ? (1.0 / canonical_target_function_other_sample) : 0.0f;
        combined_reservoir.UnbiasedCannonWeight = combined_reservoir.Wsum * inverse_target_function;
        
        Replaced = true;

        return combined_reservoir;
    } else {
        combined_reservoir.WorldPos = canonical_reservoir.WorldPos;
        combined_reservoir.OriginNormal = canonical_reservoir.OriginNormal;
        combined_reservoir.Color = canonical_reservoir.Color;

        float inverse_target_function = (canonical_target_function_canonical_sample > 0.0) ? (1.0 / canonical_target_function_canonical_sample) : 0;
        combined_reservoir.UnbiasedCannonWeight = combined_reservoir.Wsum * inverse_target_function;
        Replaced = false;

        return combined_reservoir;
    }
}
int2 permute_pixel(uint2 pixel_id, uint frame_index, float2 view_size) {
    int r = frame_index;
    int2 offset = int2(r & 3u, (r >> 2u) & 3u);
    int2 shifted_pixel_id = pixel_id + offset;
    shifted_pixel_id ^= 3u;
    shifted_pixel_id -= offset;
    return min(shifted_pixel_id, uint2(view_size - 1.0));
}

